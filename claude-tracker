def load_accounts():
    """Read the account list from config.toml, or fall back to sensible defaults."""
    entries = None
    try:
        with open(CONFIG, "rb") as f:
            entries = tomllib.load(f).get("account")
    except FileNotFoundError:
        pass
    except (OSError, tomllib.TOMLDecodeError) as error:
        print(f"claude-tracker: ignoring {CONFIG}: {error}", file=sys.stderr)
    if not entries:
        entries = [{"type": "claude", "label": "Claude", "config_dir": "~/.claude"}]
        if shutil.which("codex"):
            entries.append({"type": "codex", "label": "Codex"})

    accounts = []
    for i, entry in enumerate(entries):
        kind = entry.get("type", "claude")
        if kind not in USAGE_URLS:
            print(f"claude-tracker: unknown account type {kind!r}, skipping", file=sys.stderr)
            continue
        label = str(entry.get("label", kind.title()))
        sub = str(entry.get("sublabel", ""))
        slug = re.sub(r"[^a-z0-9]+", "-", f"{kind}-{label}-{sub}".lower()).strip("-")
        accounts.append({
            "id": f"{i}-{slug}",
            "kind": kind,
            "name": label.upper(),
            "sub": sub.upper(),
            "dir": Path(os.path.expanduser(entry.get("config_dir", "~/.claude"))),
            "command": entry.get("command", "codex"),
            "url": entry.get("url", USAGE_URLS[kind]),
        })
    return accounts


